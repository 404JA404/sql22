create database letou;

use letou;

DROP TABLE IF EXISTS cliente;

CREATE TABLE cliente (
    cliente_id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    apellido VARCHAR(100) NOT NULL,
    correo VARCHAR(150) NOT NULL,
    fecha_registro DATE NOT NULL,
    ciudad VARCHAR(100) NOT NULL,
    activo TINYINT(1) NOT NULL DEFAULT 1
);

CREATE INDEX idx_fecha_registro ON cliente(fecha_registro);
CREATE INDEX idx_ciudad_activo ON cliente(ciudad, activo);
CREATE UNIQUE INDEX idx_correo_unique ON cliente(correo);

CREATE INDEX idx_cliente_ciudad ON cliente(ciudad);

SHOW INDEX FROM cliente;

DROP INDEX idx_cliente_ciudad ON cliente;

SHOW INDEX FROM cliente;
